# Application
APP_NAME="Gradually AI"
DEBUG=False
API_V1_PREFIX="/api/v1"

# Security
SECRET_KEY="your-super-secret-key-here"  # Change this to a secure random string in production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM="HS256"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/gradually_ai"  # Format: dialect://username:password@host:port/database_name

# CORS Origins (comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE="logs/app.log"

# Redis Cache Settings
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX="gradually_ai"

# Server
HOST="0.0.0.0"
PORT=8000

# Backend Configuration
JWT_SECRET_KEY=your-secret-key
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=gradually_ai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws

# Mobile Configuration
MOBILE_API_URL=http://localhost:8000/api
MOBILE_WS_URL=ws://localhost:8000/ws

# Development Settings
DEBUG=true
LOG_LEVEL=INFO 